{
  "kind": "collectionType",
  "collectionName": "recommend_places",
  "info": {
    "singularName": "recommend-place",
    "pluralName": "recommend-places",
    "displayName": "Recommend_Place"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "image": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "description": {
      "type": "text"
    },
    "tours": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tour.tour",
      "mappedBy": "places"
    }
  }
}
