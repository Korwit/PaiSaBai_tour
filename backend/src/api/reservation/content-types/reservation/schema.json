{
  "kind": "collectionType",
  "collectionName": "reservations",
  "info": {
    "singularName": "reservation",
    "pluralName": "reservations",
    "displayName": "Reservation",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "comment": {
      "type": "string"
    },
    "payment_status": {
      "type": "boolean",
      "default": false
    },
    "payment_date": {
      "type": "date"
    },
    "tour": {
